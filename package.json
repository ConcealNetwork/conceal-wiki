{
  "name": "site",
  "version": "0.0.24",
  "private": true,
  "scripts": {
    "build": "next build",
    "build:prod": "SITE_BASE_PATH=/wiki SITE_ORIGIN=https://conceal.network next build && rm -rf dist && mv out dist",
    "dev": "next dev",
    "start": "serve out",
    "types:check": "next typegen && tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "test": "node --test tests/*.test.mjs",
    "test:static": "node --test tests/static-export.test.mjs",
    "test:prod": "EXPORT_DIR=dist SITE_BASE_PATH=/wiki SITE_ORIGIN=https://conceal.network node --test tests/static-export.test.mjs",
    "verify": "npm run lint && npm run types:check && GITHUB_PAGES=true npm run build && npm run test"
  },
  "dependencies": {
    "cn": "^0.4.0",
    "fumadocs-core": "^16.16.2",
    "fumadocs-mdx": "^15.4.6",
    "fumadocs-ui": "npm:@fumadocs/base-ui@^16.15.7",
    "lucide-react": "^1.52.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "postcss": "^8.5.29",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
