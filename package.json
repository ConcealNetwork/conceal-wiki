{
  "name": "site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "build:prod": "SITE_BASE_PATH=/wiki SITE_ORIGIN=https://conceal.network next build && rm -rf dist && mv out dist",
    "dev": "next dev",
    "types:check": "next typegen && tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "test": "node --test tests/*.test.mjs",
    "test:static": "node --test tests/static-export.test.mjs",
    "test:prod": "EXPORT_DIR=dist SITE_BASE_PATH=/wiki SITE_ORIGIN=https://conceal.network node --test tests/static-export.test.mjs",
    "verify": "npm run lint && npm run types:check && GITHUB_PAGES=true npm run build && npm run test"
  },
  "dependencies": {
    "fumadocs-core": "^16.19.7",
    "fumadocs-mdx": "^15.6.4",
    "fumadocs-ui": "npm:@fumadocs/base-ui@^16.19.3",
    "lucide-react": "^1.78.0",
    "next": "^16.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript/native": "npm:typescript@^7.0.2",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
